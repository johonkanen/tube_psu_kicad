(version 1)
# tube_power 5.2 custom design rules (KiCad 10). Derivation: kicad_next/README.md "Isolation domains".
# Net classes per domain are assigned by tools/next/setup_project.py (every net has exactly one):
#   primary   = HV_PRIMARY | PRIMARY_LV | SIGNAL      (mains-referenced, DC+ 400 V)
#   secondary = HV_SECONDARY | SECONDARY_LV           (DAB secondary: ISO_GND, 420V, -80/-100 V, 15V_ISO_SEC, 5V_ISOL)
#   heater    = HEATER                                (HT_GND, 6V3)
#   uart      = UART_ISO                              (UART island, referenced to the PC / earth; phase 2)
#   earth     = PE_EARTH                              (protective earth, Y capacitors)
#   holes     = mounting holes H1-H4, H6-H8 (plain 3.0 mm NPTH, no copper since routing stage 13c; the M3 screw with its
#               6 mm head / standoff is bonded to the earthed chassis)
# Every rule is written for both orders of A and B. Outer layers: clearance (air) + creepage (surface,
# KiCad follows slots in Edge.Cuts). Inner layers: no creepage in the laminate is claimed (no cemented-
# joint qualification of the JLC laminate), so the inner-layer spacing equals the outer creepage.
# Distance through insulation (layer to layer) is not checked by KiCad: no copper of one domain may
# overlap copper of another domain on any other layer (barrier keep-out, phase 5/6).

# ---------------------------------------------------------------------------------------------------
# JLC 6-layer manufacturing limits that the board minimums (kicad_pro) cannot express
# (jlcpcb.com/capabilities/pcb-capabilities, read 2026-11-17)
(rule "JLC PTH pad annular ring >= 0.15 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.15mm)))

(rule "JLC pad hole to pad hole >= 0.45 mm"
	(condition "A.Type == 'Pad' && B.Type == 'Pad'")
	(constraint hole_to_hole (min 0.45mm)))

(rule "JLC NPTH >= 0.5 mm"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_size (min 0.5mm)))

# ---------------------------------------------------------------------------------------------------
# Fine-pitch ICs (U10 VSSOP-8, 0.65 mm pitch: pad gap 0.15 mm): pads of the same footprint on low-voltage
# nets may be 0.15 mm apart (JLC minimum pad spacing; the net class clearances 0.2 mm of PRIMARY_LV /
# SECONDARY_LV / HEATER stay for everything else). HV classes keep their class clearance. Tested by
# tools/next/check_rules.py (PAD_TESTS).
(rule "Same-footprint pad gap, low-voltage classes"
	(condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent == B.Parent && !A.hasNetclass('HV_PRIMARY') && !A.hasNetclass('HV_SECONDARY') && !B.hasNetclass('HV_PRIMARY') && !B.hasNetclass('HV_SECONDARY') && !A.hasNetclass('PE_EARTH') && !B.hasNetclass('PE_EARTH')")
	(constraint clearance (min 0.15mm)))

# ---------------------------------------------------------------------------------------------------
# PRIMARY_LV supply nets (GND, 15V, 5V, +3V3, +1V65_BIAS) on the INNER layers: 0.15 mm to another PRIMARY_LV or
# SIGNAL net (user decision 2026-11-20, routing stage 3d). The net class clearance of PRIMARY_LV is 0.2 mm on all
# layers; the kept 5.1 runs on In2 (5V, $HT_CS, +1V65_BIAS, GND vias) are 0.156 ... 0.19 mm from their neighbours
# at <= 15 V, and JLC needs 0.09 mm. Outer layers keep 0.2 mm (solder side). Tracks, vias and pads only: zone
# fills keep the class / zone clearance; towards a HV net or another domain the rules below and the HV class
# clearance stay (the condition names the two low-voltage primary classes). The same exception is in
# tools/next/s3_router.py (World.gap); tested by tools/next/check_rules.py (inner 0.16 mm passes, outer fails).
(rule "PRIMARY_LV inner layers 0.15 mm"
	(layer inner)
	(condition "A.Type != 'Zone' && B.Type != 'Zone' && A.Net != B.Net && ((A.hasNetclass('PRIMARY_LV') && (B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL'))) || (B.hasNetclass('PRIMARY_LV') && (A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL'))))")
	(constraint clearance (min 0.15mm)))

# ---------------------------------------------------------------------------------------------------
# Functional spacing inside a domain: HV nets on the outer layers (tracks / zones; pad-to-pad gaps are
# set by the parts, e.g. TO-220 / TO-247 pin pitch). Inner layers: net class clearance 0.5 mm.
# Not towards the pad of a no-connect pin (net "unconnected-(...)", routing stage 3c): such a pad carries no
# voltage of its own, it is a piece of the package's pin row (UCC21520 pins 12 / 13 between the two output
# channels); the net class clearance (0.5 mm for a HV net) stays. Tested by tools/next/check_rules.py (NC_TESTS).
(rule "HV functional, outer layers"
	(layer outer)
	(condition "(A.hasNetclass('HV_PRIMARY') || A.hasNetclass('HV_SECONDARY') || B.hasNetclass('HV_PRIMARY') || B.hasNetclass('HV_SECONDARY')) && !(A.Type == 'Pad' && B.Type == 'Pad') && A.Net != B.Net && !(A.Type == 'Pad' && A.NetName == 'unconnected-*') && !(B.Type == 'Pad' && B.NetName == 'unconnected-*')")
	(constraint clearance (min 1.2mm)))

# Exception (user decision 2026-11-20, routing stage 3b): the nets of ONE floating high-side gate driver - gate
# path, source / switch-node return, bootstrap supply - are at most about 20 V apart, so the 1.2 mm above (and
# the 0.5 mm of the HV net classes) is not needed between them and would forbid a tight gate loop at 1.27 mm pin
# pitch: 0.2 mm inside one group. Both items must be in the SAME group; towards DC+, the low side, another group
# or any other net the rules above stay. Outer layers only (no switch node on an inner layer). The same lists
# are in tools/next/s3_router.py (HS_GROUPS); tested by tools/next/check_rules.py.
(rule "High-side driver group DRV3, outer layers"
	(layer outer)
	(condition "(A.NetName == '/06 Heaters/HEATER_HI_GATE' || A.NetName == '/06 Heaters/HEATER_HI_SOURCE' || A.NetName == '/06 Heaters/HEATER_HI_DRV' || A.NetName == 'Net-(DRV3-VDDA)' || A.NetName == 'Net-(D35-K)' || A.NetName == 'Net-(D11-K)') && (B.NetName == '/06 Heaters/HEATER_HI_GATE' || B.NetName == '/06 Heaters/HEATER_HI_SOURCE' || B.NetName == '/06 Heaters/HEATER_HI_DRV' || B.NetName == 'Net-(DRV3-VDDA)' || B.NetName == 'Net-(D35-K)' || B.NetName == 'Net-(D11-K)') && A.Net != B.Net")
	(constraint clearance (min 0.2mm)))

(rule "High-side driver group DRV5, outer layers"
	(layer outer)
	(condition "(A.NetName == 'DHB_HI_GATE' || A.NetName == 'DHB_HI_SOURCE' || A.NetName == 'Net-(DRV5-VDDA)' || A.NetName == 'Net-(D19-K)' || A.NetName == 'Net-(D30-PadA)' || A.NetName == 'Net-(Q19-G)') && (B.NetName == 'DHB_HI_GATE' || B.NetName == 'DHB_HI_SOURCE' || B.NetName == 'Net-(DRV5-VDDA)' || B.NetName == 'Net-(D19-K)' || B.NetName == 'Net-(D30-PadA)' || B.NetName == 'Net-(Q19-G)') && A.Net != B.Net")
	(constraint clearance (min 0.2mm)))

(rule "High-side driver group DRV6, outer layers"
	(layer outer)
	(condition "(A.NetName == 'DHB_HI_GATE_SEC' || A.NetName == 'DHB_HI_SOURCE_SEC' || A.NetName == 'Net-(DRV6-VDDA)' || A.NetName == 'Net-(D18-K)' || A.NetName == 'Net-(D31-PadA)' || A.NetName == 'Net-(Q21-G)') && (B.NetName == 'DHB_HI_GATE_SEC' || B.NetName == 'DHB_HI_SOURCE_SEC' || B.NetName == 'Net-(DRV6-VDDA)' || B.NetName == 'Net-(D18-K)' || B.NetName == 'Net-(D31-PadA)' || B.NetName == 'Net-(Q21-G)') && A.Net != B.Net")
	(constraint clearance (min 0.2mm)))

# ---------------------------------------------------------------------------------------------------
# Primary <-> DAB secondary: REINFORCED. Working voltage 552 Vrms / 778 Vpk (ISO_GND is always earthed
# via the amplifier chassis - confirmed by the user 2026-11-17): creepage 2 x 5.52 mm (IEC 60664-1 Table F.5 / IEC 62368-1 Table 17, PD2, MG III,
# interpolated) -> 11.1 mm; clearance: reinforced for 2500 V mains transient = 3.0 mm, 4.0 mm used.
(rule "PRI-SEC reinforced clearance"
	(layer outer)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && (B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV'))) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && (A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')))")
	(constraint clearance (min 4.0mm)))

(rule "PRI-SEC reinforced creepage"
	(layer outer)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && (B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV'))) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && (A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')))")
	(constraint creepage (min 11.1mm)))

(rule "PRI-SEC inner layers"
	(layer inner)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && (B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV'))) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && (A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')))")
	(constraint clearance (min 11.1mm))
	(constraint hole_clearance (min 11.1mm)))

# (The exception 'PRI-SEC inner layers, Q19/Q21 across the barrier slot' of 2026-11-19 was removed in routing
# stage 4k, 2026-11-22: Q19 stands in the single primary heatsink line since stage 4a and is no longer next to
# Q21, so no pair needs it. Every primary <-> secondary pair on the inner layers is checked at 11.1 mm.)

# ---------------------------------------------------------------------------------------------------
# Primary <-> heater: REINFORCED. With HT_GND at the -100 V bias (ISO_GND earthed) DC+ - HT = 400 + 100 + GND(t), GND(t) =
# min(0, 358 sin): the 100 V is a DC shift and adds linearly (not in quadrature as sqrt(318^2 + 100^2) = 333 Vrms
# assumed before): 410 Vrms, 500 Vpk (design review 2026-11-23, findings 10 A1 / F3). Basic 4.1 mm (IEC 60664-1 F.5 PD2
# MG III, 400 / 500 V rows 4.0 / 5.0 interpolated), reinforced 2 x 4.1 = 8.2 mm (was 8.0 until routing stage 13d).
# Clearance 4.0 mm (reinforced for the 2500 V mains transient = 3.0 mm).
(rule "PRI-HEATER reinforced clearance"
	(layer outer)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && B.hasNetclass('HEATER')) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && A.hasNetclass('HEATER'))")
	(constraint clearance (min 4.0mm)))

(rule "PRI-HEATER reinforced creepage"
	(layer outer)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && B.hasNetclass('HEATER')) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && A.hasNetclass('HEATER'))")
	(constraint creepage (min 8.2mm)))

(rule "PRI-HEATER inner layers"
	(layer inner)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && B.hasNetclass('HEATER')) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && A.hasNetclass('HEATER'))")
	(constraint clearance (min 8.2mm))
	(constraint hole_clearance (min 8.2mm)))

# Primary <-> UART island: REINFORCED, user-touchable. Working voltage 318 Vrms / 400 Vpk (island earthed through the PC):
# reinforced 2 x 3.2 = 6.4 mm, 8.0 mm used (plan target >= 8 mm). Clearance 4.0 mm as above.
(rule "PRI-UART reinforced clearance"
	(layer outer)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && B.hasNetclass('UART_ISO')) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && A.hasNetclass('UART_ISO'))")
	(constraint clearance (min 4.0mm)))

(rule "PRI-UART reinforced creepage"
	(layer outer)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && B.hasNetclass('UART_ISO')) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && A.hasNetclass('UART_ISO'))")
	(constraint creepage (min 8.0mm)))

(rule "PRI-UART inner layers"
	(layer inner)
	(condition "((A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')) && B.hasNetclass('UART_ISO')) || ((B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL')) && A.hasNetclass('UART_ISO'))")
	(constraint clearance (min 8.0mm))
	(constraint hole_clearance (min 8.0mm)))

# ---------------------------------------------------------------------------------------------------
# DAB secondary <-> UART island: REINFORCED (420 V ES3 to a user-touchable circuit). 420 Vrms (DC):
# creepage 2 x 4.2 = 8.4 mm; clearance reinforced for a 1500 V transient (secondary behind reinforced
# insulation, one OVC step lower) = 1.5 mm, 3.0 mm used.
(rule "SEC-UART reinforced clearance"
	(layer outer)
	(condition "((A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')) && B.hasNetclass('UART_ISO')) || ((B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV')) && A.hasNetclass('UART_ISO'))")
	(constraint clearance (min 3.0mm)))

(rule "SEC-UART reinforced creepage"
	(layer outer)
	(condition "((A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')) && B.hasNetclass('UART_ISO')) || ((B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV')) && A.hasNetclass('UART_ISO'))")
	(constraint creepage (min 8.4mm)))

(rule "SEC-UART inner layers"
	(layer inner)
	(condition "((A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')) && B.hasNetclass('UART_ISO')) || ((B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV')) && A.hasNetclass('UART_ISO'))")
	(constraint clearance (min 8.4mm))
	(constraint hole_clearance (min 8.4mm)))

# ---------------------------------------------------------------------------------------------------
# DAB secondary <-> heater: FUNCTIONAL (user 2026-11-17: the heater supply is tied to the negative bias
# supply (-100V BIAS) or to signal ground through 100 ohm, i.e. referenced to the earthed secondary).
# Largest difference: heater at -100 V vs 420V = 520 V -> creepage 5.2 mm (IEC 60664-1 Table F.5,
# PD2, MG III, 500-630 V rows interpolated), clearance 1.5 mm. To the low-voltage secondary nets
# (ISO_GND, 15V_ISO_SEC, 5V_ISOL): <= 115 V -> 1.5 mm creepage, 1.0 mm clearance.
(rule "SEC(HV)-HEATER functional"
	(layer outer)
	(condition "(A.hasNetclass('HV_SECONDARY') && B.hasNetclass('HEATER')) || (B.hasNetclass('HV_SECONDARY') && A.hasNetclass('HEATER'))")
	(constraint clearance (min 1.5mm))
	(constraint creepage (min 5.2mm)))

(rule "SEC(HV)-HEATER inner layers"
	(layer inner)
	(condition "(A.hasNetclass('HV_SECONDARY') && B.hasNetclass('HEATER')) || (B.hasNetclass('HV_SECONDARY') && A.hasNetclass('HEATER'))")
	(constraint clearance (min 5.2mm))
	(constraint hole_clearance (min 5.2mm)))

(rule "SEC(LV)-HEATER functional"
	(condition "(A.hasNetclass('SECONDARY_LV') && B.hasNetclass('HEATER')) || (B.hasNetclass('SECONDARY_LV') && A.hasNetclass('HEATER'))")
	(constraint clearance (min 1.0mm))
	(constraint creepage (min 1.5mm)))

# Heater <-> UART: functional (both ELV, earthed).
(rule "HEATER-UART functional"
	(condition "(A.hasNetclass('HEATER') && B.hasNetclass('UART_ISO')) || (B.hasNetclass('HEATER') && A.hasNetclass('UART_ISO'))")
	(constraint clearance (min 1.0mm)))

# ---------------------------------------------------------------------------------------------------
# Protective earth (Y capacitors): BASIC to primary (318 Vrms -> creepage 3.2 mm, clearance 2.0 mm),
# BASIC to the DAB secondary (420 Vrms -> 4.2 mm, 1.5 mm).
(rule "PE-PRI basic"
	(layer outer)
	(condition "(A.hasNetclass('PE_EARTH') && (B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL'))) || (B.hasNetclass('PE_EARTH') && (A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')))")
	(constraint clearance (min 2.0mm))
	(constraint creepage (min 3.2mm)))

(rule "PE-PRI basic, inner layers"
	(layer inner)
	(condition "(A.hasNetclass('PE_EARTH') && (B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL'))) || (B.hasNetclass('PE_EARTH') && (A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')))")
	(constraint clearance (min 3.2mm)))

(rule "PE-SEC basic"
	(layer outer)
	(condition "(A.hasNetclass('PE_EARTH') && (B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV'))) || (B.hasNetclass('PE_EARTH') && (A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')))")
	(constraint clearance (min 1.5mm))
	(constraint creepage (min 4.2mm)))

(rule "PE-SEC basic, inner layers"
	(layer inner)
	(condition "(A.hasNetclass('PE_EARTH') && (B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV'))) || (B.hasNetclass('PE_EARTH') && (A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')))")
	(constraint clearance (min 4.2mm)))

# ---------------------------------------------------------------------------------------------------
# Mounting holes H1-H4, H6-H8: the screws bond the board to the chassis, which is earthed (user 2026-11-17),
# so they are protective earth: BASIC like PE above - primary 318 Vrms: creepage 3.2 mm, clearance 2.0 mm;
# DAB secondary 420 Vrms: 4.2 mm / 1.5 mm. Since routing stage 13c (design review 2026-11-23) the holes have no copper
# ring and the distance is taken from the earthed metal a screw brings: a 6 mm head / standoff (radius 3.0 mm round
# the 3.0 mm hole). KiCad measures from the hole wall (radius 1.5 mm), so every value below is the distance from the
# head + 1.5 mm: primary 3.2 + 1.5 = 4.7 mm (6.2 mm from the centre), secondary 4.2 + 1.5 = 5.7 mm (7.2 mm). The
# clearance / creepage constraints carry the same value (an NPTH without copper is checked through its hole);
# hole_clearance acts on every layer, i.e. the inner layers keep the same plan distance. check_domains.py models
# the head as a 6 mm disc on every layer.
(rule "Mounting hole - primary"
	(condition "(A.memberOfFootprint('H?') && (B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL'))) || (B.memberOfFootprint('H?') && (A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')))")
	(constraint clearance (min 4.7mm))
	(constraint creepage (min 4.7mm))
	(constraint hole_clearance (min 4.7mm)))

(rule "Mounting hole - secondary"
	(condition "(A.memberOfFootprint('H?') && (B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV'))) || (B.memberOfFootprint('H?') && (A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')))")
	(constraint clearance (min 5.7mm))
	(constraint creepage (min 5.7mm))
	(constraint hole_clearance (min 5.7mm)))

# UART island (H2): functional 1.0 mm from the head = 2.5 mm from the hole wall.
(rule "Mounting hole - UART"
	(condition "(A.memberOfFootprint('H?') && B.hasNetclass('UART_ISO')) || (B.memberOfFootprint('H?') && A.hasNetclass('UART_ISO'))")
	(constraint clearance (min 2.5mm))
	(constraint hole_clearance (min 2.5mm)))

# Holes where fixed parts (pads) stand nearer to the head than the values above: the rule holds what the copper
# achieves (stage 13c, best effort without moving parts or other nets' isolation), and these holes need insulating
# hardware (nylon screw / standoff or insulating washers: kicad_next/README.md stage 13c, kicad_next/fab/README.md).
# Later rules take precedence. Values from the hole wall; from the 6 mm head subtract 1.5 mm.
#   H4: In3 PRI_DHB_HI 4.93 mm from the centre (In2 control bus 4.95, F.Cu PFC_DRAIN_1 pour 4.98, DRV5 pad 16 5.03,
#       L2 pad 2 5.08) -> 3.4 mm (head 1.9 mm, 3.2 required)
#   H7: In2 Net-(R48-Pad2) 5.08 mm, B.Cu R48 pad 1 / R47 pad 2 5.08 / 5.11 mm since stage 14g (was 5.18 mm; F.Cu / In1 / In3 / In4 >= 6.27) -> 3.5 mm (head 2.0 mm)
#   H8: C102 pad 1 (ISO_GND, all layers) 6.23 mm -> 4.7 mm (head 3.2 mm, 4.2 required)
#   H2: B.Cu ISO_UART_GND bus 3.13 mm, F.Cu UART_TXD 3.50, J4 pad 1 3.68 -> 1.6 mm (head 0.1 mm, 1.0 required)
(rule "Mounting hole H4 - primary (achieved, insulating hardware)"
	(condition "(A.memberOfFootprint('H4') && (B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL'))) || (B.memberOfFootprint('H4') && (A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')))")
	(constraint clearance (min 3.4mm))
	(constraint creepage (min 3.4mm))
	(constraint hole_clearance (min 3.4mm)))

(rule "Mounting hole H7 - primary (achieved, insulating hardware)"
	(condition "(A.memberOfFootprint('H7') && (B.hasNetclass('HV_PRIMARY') || B.hasNetclass('PRIMARY_LV') || B.hasNetclass('SIGNAL'))) || (B.memberOfFootprint('H7') && (A.hasNetclass('HV_PRIMARY') || A.hasNetclass('PRIMARY_LV') || A.hasNetclass('SIGNAL')))")
	(constraint clearance (min 3.5mm))
	(constraint creepage (min 3.5mm))
	(constraint hole_clearance (min 3.5mm)))

(rule "Mounting hole H8 - secondary (achieved, insulating hardware)"
	(condition "(A.memberOfFootprint('H8') && (B.hasNetclass('HV_SECONDARY') || B.hasNetclass('SECONDARY_LV'))) || (B.memberOfFootprint('H8') && (A.hasNetclass('HV_SECONDARY') || A.hasNetclass('SECONDARY_LV')))")
	(constraint clearance (min 4.7mm))
	(constraint creepage (min 4.7mm))
	(constraint hole_clearance (min 4.7mm)))

(rule "Mounting hole H2 - UART (achieved, insulating hardware)"
	(condition "(A.memberOfFootprint('H2') && B.hasNetclass('UART_ISO')) || (B.memberOfFootprint('H2') && A.hasNetclass('UART_ISO'))")
	(constraint clearance (min 1.6mm))
	(constraint hole_clearance (min 1.6mm)))
